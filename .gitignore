# Overrides locais
AGENTS.local.md
CLAUDE.local.md

# Obsidian: toda a configuração do vault é versionada.
# Não adicione regras para .obsidian/ neste arquivo.

# Anotações dos alunos (só README versionado)
notas/**
!notas/README.md

# legacy path if recreated
cursos/_notas-pessoais/**

# Root-only library tooling
/scripts/
/docs/
/dev/
/.github/

# IDE runtime projections
.claude/
.codex/
.agents/
.aiox/

# Python local
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editores
.idea/
.vscode/
*.swp
*.swo
*~

# Outputs gerados na raiz
/dist/
/build/
/tmp/
/temp/
*.tgz
npm-debug.log*

# Resíduos de merge, patch e backup
*.orig
*.rej
*.backup.*

# Obsidian é canônico por inteiro; sobrescreve todas as regras genéricas acima.
!/.obsidian/
!/.obsidian/**
