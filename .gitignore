.DS_Store
.env
.env.*
node_modules/
__pycache__/
*.pyc
*.bak
.synapse/
*.agents/
.agents/
.aiox/
.sync-tmp/
*.local.yaml
*.local.yml
coverage/
outputs/
artifacts/
