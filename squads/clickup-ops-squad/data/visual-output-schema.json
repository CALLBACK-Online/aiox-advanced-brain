{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-extraction-output-v1",
  "title": "Visual Extraction Output",
  "description": "Schema do output produzido pela extracao visual+verbal de videos de demonstracao ClickUp. Compativel com o video-analysis pipeline.",
  "type": "object",
  "required": ["source", "segments", "relationships_discovered", "heuristics_captured", "summary"],
  "properties": {
    "source": {
      "type": "object",
      "description": "Metadados do video fonte.",
      "required": ["type", "title", "duration", "speaker", "extraction_date"],
      "properties": {
        "type": {
          "type": "string",
          "const": "video_visual",
          "description": "Tipo fixo para extracoes visuais de video."
        },
        "title": {
          "type": "string",
          "description": "Titulo do video como publicado.",
          "examples": ["ClickUp Pipeline de Vendas - Setup Completo"]
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "URL do video se disponivel (YouTube, Loom, etc).",
          "examples": ["https://www.youtube.com/watch?v=abc123"]
        },
        "duration": {
          "type": "string",
          "pattern": "^[0-9]{1,3}:[0-5][0-9]$",
          "description": "Duracao total do video no formato MM:SS ou MMM:SS.",
          "examples": ["45:30", "120:15"]
        },
        "speaker": {
          "type": "string",
          "description": "Nome do speaker principal.",
          "default": "Example User"
        },
        "extraction_date": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora ISO 8601 de quando a extracao foi realizada.",
          "examples": ["2026-03-07T14:30:00Z"]
        },
        "video_publish_date": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Data de publicacao do video se conhecida.",
          "examples": ["2026-02-15"]
        },
        "description": {
          "type": ["string", "null"],
          "description": "Descricao ou resumo do video se disponivel."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tags ou topicos do video.",
          "examples": [["clickup", "vendas", "pipeline", "automacao"]]
        }
      }
    },
    "segments": {
      "type": "array",
      "description": "Array de TODOS os eventos capturados do video. Cada segmento e uma observacao atomica.",
      "items": {
        "type": "object",
        "required": ["timestamp", "type", "category", "content", "confidence", "evidence_type", "layer_hint"],
        "properties": {
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{1,3}:[0-5][0-9]$",
            "description": "Momento exato no video, formato MM:SS.",
            "examples": ["02:15", "45:03"]
          },
          "type": {
            "type": "string",
            "enum": ["tela", "fala", "acao", "divergencia"],
            "description": "Origem da informacao. tela=visual na tela, fala=audio do apresentador, acao=clique/navegacao do apresentador, divergencia=tela contradiz fala."
          },
          "category": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I"],
            "description": "Categoria de captura conforme definido no prompt. A=Workspace Structure, B=Custom Fields, C=Status Workflows, D=Automations/Integrations, E=Views/Dashboards, F=Relationships/Navigation, G=Usage Patterns/Heuristics, H=Numeric Data/IDs, I=Templates/Checklists."
          },
          "content": {
            "type": "string",
            "minLength": 5,
            "description": "Descricao exata do que foi observado. Para fala, usar aspas para texto verbatim do apresentador. Para tela, descrever o que e visivel."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Qualidade da evidencia. high=texto nitido/audio claro. medium=parcialmente visivel/audio razoavel. low=desfocado/audio ruim/inferido."
          },
          "identifiers": {
            "type": "object",
            "description": "Identificadores tecnicos extraidos deste segmento. Todos os arrays podem estar vazios se nao aplicavel.",
            "properties": {
              "ids": {
                "type": "array",
                "items": { "type": "string" },
                "description": "IDs numericos ou alfanumericos capturados (task IDs, list IDs, space IDs, UUIDs de campos).",
                "examples": [["901303868897", "86drtm3", "a1b2c3d4-e5f6-7890-abcd-ef1234567890"]]
              },
              "names": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Nomes proprios de entidades ClickUp (Spaces, Folders, Lists, Tasks). Exatamente como escritos na tela.",
                "examples": [["CASTING", "Pipeline Vendas", "Leads Novos"]]
              },
              "fields": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Nomes de Custom Fields capturados.",
                "examples": [["Status Lead", "Responsavel", "Data Fechamento", "Valor Proposta"]]
              },
              "statuses": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Nomes de status capturados.",
                "examples": [["Em Prospecao", "Qualificado", "Proposta Enviada", "Fechado Ganho"]]
              },
              "urls": {
                "type": "array",
                "items": { "type": "string" },
                "description": "URLs completas capturadas (ClickUp, webhooks, APIs, N8N).",
                "examples": [["https://app.clickup.com/12345678/v/li/901302345678"]]
              },
              "keys": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Prefixos ou chaves de dropdown observados ([CAP], [VND], [OPS], etc).",
                "examples": [["[CAP]", "[VND]", "[PRJ]"]]
              }
            }
          },
          "context": {
            "type": ["string", "null"],
            "description": "Contexto anterior ao momento da captura. O que apresentador estava fazendo/dizendo imediatamente antes."
          },
          "evidence_type": {
            "type": "string",
            "enum": ["visual", "verbal", "both"],
            "description": "Onde a evidencia foi observada. visual=so tela. verbal=so fala. both=tela+fala simultaneamente (candidato TRUTH)."
          },
          "layer_hint": {
            "type": "string",
            "enum": ["clickup", "n8n", "supabase", "agents", "unknown"],
            "description": "System layer this segment likely belongs to."
          },
          "truth_candidate": {
            "type": "boolean",
            "default": false,
            "description": "true se este segmento e candidato a classificacao TRUTH (evidence_type=both com identificador tecnico exato)."
          },
          "related_segment_indices": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Indices (0-based) de outros segmentos neste mesmo array que estao relacionados a este (ex: um segmento de tela e um de fala sobre o mesmo elemento)."
          },
          "field_metadata": {
            "type": ["object", "null"],
            "description": "Metadados adicionais para segmentos de categoria B (Custom Fields). Null para outras categorias.",
            "properties": {
              "field_name": {
                "type": "string",
                "description": "Nome exato do campo."
              },
              "field_type": {
                "type": "string",
                "enum": [
                  "dropdown", "text", "short_text", "number", "date", "people",
                  "checkbox", "relationship", "email", "phone", "url", "currency",
                  "rating", "button", "formula", "label", "location", "files",
                  "automatic_progress", "tasks", "rollup", "unknown"
                ],
                "description": "Tipo do custom field no ClickUp."
              },
              "field_uuid": {
                "type": ["string", "null"],
                "description": "UUID do campo se visivel."
              },
              "options": {
                "type": ["array", "null"],
                "items": { "type": "string" },
                "description": "Opcoes do dropdown se visivel."
              },
              "required": {
                "type": ["boolean", "null"],
                "description": "Se o campo e obrigatorio."
              },
              "formula": {
                "type": ["string", "null"],
                "description": "Formula do campo se visivel e aplicavel."
              },
              "relationship_target": {
                "type": ["string", "null"],
                "description": "Para campos tipo relationship: nome da lista alvo."
              }
            }
          },
          "status_metadata": {
            "type": ["object", "null"],
            "description": "Metadados adicionais para segmentos de categoria C (Status Workflows). Null para outras categorias.",
            "properties": {
              "status_name": {
                "type": "string",
                "description": "Nome exato do status."
              },
              "color": {
                "type": ["string", "null"],
                "description": "Cor do status (hex ou nome descritivo).",
                "examples": ["#4CAF50", "verde", "azul"]
              },
              "group": {
                "type": ["string", "null"],
                "enum": ["open", "in_progress", "closed", null],
                "description": "Grupo do status no ClickUp."
              },
              "position": {
                "type": ["integer", "null"],
                "description": "Posicao ordinal do status na sequencia (1-based)."
              },
              "task_count": {
                "type": ["integer", "null"],
                "description": "Numero de tasks visivel neste status."
              }
            }
          },
          "automation_metadata": {
            "type": ["object", "null"],
            "description": "Metadados adicionais para segmentos de categoria D (Automacoes). Null para outras categorias.",
            "properties": {
              "trigger": {
                "type": ["string", "null"],
                "description": "Descricao do trigger da automacao."
              },
              "condition": {
                "type": ["string", "null"],
                "description": "Condicao da automacao se existir."
              },
              "action": {
                "type": ["string", "null"],
                "description": "Acao executada pela automacao."
              },
              "webhook_url": {
                "type": ["string", "null"],
                "description": "URL do webhook se visivel."
              },
              "integration": {
                "type": ["string", "null"],
                "enum": ["n8n", "make", "zapier", "slack", "google_drive", "whatsapp", "email", "api_direct", "native_clickup", null],
                "description": "Plataforma de integracao associada."
              }
            }
          }
        }
      }
    },
    "relationships_discovered": {
      "type": "array",
      "description": "Relacionamentos entre entidades descobertos durante a extracao.",
      "items": {
        "type": "object",
        "required": ["from", "to", "relationship_type", "evidence"],
        "properties": {
          "from": {
            "type": "object",
            "required": ["type", "name"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["space", "folder", "list", "task", "field", "status", "workflow", "webhook", "automation", "view", "template"],
                "description": "Tipo da entidade de origem."
              },
              "name": {
                "type": "string",
                "description": "Nome da entidade de origem."
              },
              "id": {
                "type": ["string", "null"],
                "description": "ID da entidade se capturado."
              }
            }
          },
          "to": {
            "type": "object",
            "required": ["type", "name"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["space", "folder", "list", "task", "field", "status", "workflow", "webhook", "automation", "view", "template"],
                "description": "Tipo da entidade de destino."
              },
              "name": {
                "type": "string",
                "description": "Nome da entidade de destino."
              },
              "id": {
                "type": ["string", "null"],
                "description": "ID da entidade se capturado."
              }
            }
          },
          "relationship_type": {
            "type": "string",
            "enum": [
              "contains",
              "related_task",
              "subtask",
              "added_to",
              "dependency_blocking",
              "dependency_waiting",
              "triggers",
              "feeds_into",
              "references",
              "relationship_field",
              "status_transition",
              "webhook_target"
            ],
            "description": "Tipo do relacionamento entre as entidades."
          },
          "evidence": {
            "type": "string",
            "description": "Timestamp + descricao de como o relacionamento foi descoberto."
          },
          "evidence_type": {
            "type": "string",
            "enum": ["visual", "verbal", "both"],
            "description": "Se o relacionamento foi observado visualmente, verbalmente, ou ambos."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Confianca na existencia deste relacionamento."
          }
        }
      }
    },
    "heuristics_captured": {
      "type": "array",
      "description": "Principios, anti-patterns, regras e heuristicas verbalizadas pelo apresentador.",
      "items": {
        "type": "object",
        "required": ["id", "statement", "timestamp"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HEUR-[0-9]{3}$",
            "description": "Identificador unico da heuristica, sequencial por video.",
            "examples": ["HEUR-001", "HEUR-042"]
          },
          "type": {
            "type": "string",
            "enum": ["principle", "anti_pattern", "methodology", "comparison", "metric", "naming_convention", "workflow_rule"],
            "description": "Tipo de heuristica capturada."
          },
          "statement": {
            "type": "string",
            "description": "Frase verbatim do apresentador entre aspas. Exatamente como ele disse."
          },
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{1,3}:[0-5][0-9]$",
            "description": "Momento no video."
          },
          "context": {
            "type": ["string", "null"],
            "description": "O que estava na tela quando apresentador disse isso. O contexto visual que motivou a declaracao."
          },
          "related_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I"]
            },
            "description": "Categorias de captura relevantes para esta heuristica."
          },
          "pattern_mapping": {
            "type": ["string", "null"],
            "description": "Se esta heuristica corresponde a um padrao ja catalogado. Ex: FILOSOFIA-PV-003, HEURISTICA-PV-007.",
            "examples": ["FILOSOFIA-PV-003", "MODELO-MENTAL-PV-003", null]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Contagem de todos os elementos unicos encontrados na extracao.",
      "required": ["total_segments", "truth_candidates"],
      "properties": {
        "spaces_seen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Nomes unicos de Spaces observados."
        },
        "folders_seen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Nomes unicos de Folders observados."
        },
        "lists_seen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Nomes unicos de Lists observados."
        },
        "fields_seen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Nomes unicos de Custom Fields observados."
        },
        "statuses_seen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Nomes unicos de Status observados."
        },
        "automations_seen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Descricoes curtas de automacoes observadas."
        },
        "views_seen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tipos de views observados."
        },
        "integrations_seen": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Plataformas de integracao observadas.",
          "examples": [["n8n", "google_drive", "slack"]]
        },
        "ids_captured": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["team_id", "space_id", "folder_id", "list_id", "task_id", "field_uuid", "view_id", "webhook_id", "workflow_id"],
                "description": "Tipo do ID."
              },
              "value": {
                "type": "string",
                "description": "Valor do ID."
              },
              "context": {
                "type": "string",
                "description": "Onde este ID foi visto (nome da entidade associada)."
              }
            }
          },
          "description": "Todos os IDs tecnicos unicos capturados com seu tipo e contexto."
        },
        "total_segments": {
          "type": "integer",
          "minimum": 0,
          "description": "Numero total de segmentos no array segments."
        },
        "segments_by_type": {
          "type": "object",
          "properties": {
            "tela": { "type": "integer", "minimum": 0 },
            "fala": { "type": "integer", "minimum": 0 },
            "acao": { "type": "integer", "minimum": 0 },
            "divergencia": { "type": "integer", "minimum": 0 }
          },
          "description": "Contagem de segmentos por tipo."
        },
        "segments_by_category": {
          "type": "object",
          "properties": {
            "A": { "type": "integer", "minimum": 0, "description": "Workspace Structure" },
            "B": { "type": "integer", "minimum": 0, "description": "Custom Fields" },
            "C": { "type": "integer", "minimum": 0, "description": "Status Workflows" },
            "D": { "type": "integer", "minimum": 0, "description": "Automations" },
            "E": { "type": "integer", "minimum": 0, "description": "Views/Dashboards" },
            "F": { "type": "integer", "minimum": 0, "description": "Relationships" },
            "G": { "type": "integer", "minimum": 0, "description": "Heuristics" },
            "H": { "type": "integer", "minimum": 0, "description": "IDs/Numbers" },
            "I": { "type": "integer", "minimum": 0, "description": "Templates" }
          },
          "description": "Contagem de segmentos por categoria."
        },
        "segments_by_evidence": {
          "type": "object",
          "properties": {
            "visual": { "type": "integer", "minimum": 0 },
            "verbal": { "type": "integer", "minimum": 0 },
            "both": { "type": "integer", "minimum": 0 }
          },
          "description": "Contagem de segmentos por tipo de evidencia."
        },
        "truth_candidates": {
          "type": "integer",
          "minimum": 0,
          "description": "Numero de segmentos com evidence_type=both que sao candidatos a classificacao TRUTH."
        },
        "total_heuristics": {
          "type": "integer",
          "minimum": 0,
          "description": "Numero de heuristicas capturadas."
        },
        "total_relationships": {
          "type": "integer",
          "minimum": 0,
          "description": "Numero de relacionamentos descobertos."
        },
        "total_divergences": {
          "type": "integer",
          "minimum": 0,
          "description": "Numero de divergencias tela vs fala registradas."
        }
      }
    }
  }
}
