{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "validation-report.schema.json",
  "title": "Validation Report",
  "description": "Structured validation report schema for squad QA pipeline (EPIC-109 C4).",
  "type": "object",
  "required": [
    "squad_name",
    "version",
    "timestamp",
    "total_checks",
    "passed",
    "failed",
    "skipped",
    "blocking_passed",
    "final_score",
    "verdict",
    "dimensions",
    "checks",
    "recommended_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "squad_name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the squad being validated"
    },
    "version": {
      "type": "string",
      "description": "Version of the squad under validation (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime of when the report was generated"
    },
    "total_checks": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of checks executed"
    },
    "passed": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of checks that passed"
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of checks that failed"
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of checks that were skipped"
    },
    "blocking_passed": {
      "type": "boolean",
      "description": "Whether all blocking checks passed (false = overall FAIL regardless of score)"
    },
    "final_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Final QA score on a 0–10 scale"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "CONDITIONAL", "FAIL"],
      "description": "Overall verdict: PASS (>=7.0), CONDITIONAL (>=5.0 <7.0), FAIL (<5.0 or blocking_passed=false)"
    },
    "dimensions": {
      "type": "object",
      "description": "Per-dimension breakdown of scores",
      "additionalProperties": {
        "$ref": "#/definitions/dimension"
      }
    },
    "checks": {
      "type": "array",
      "description": "List of individual checks with results",
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "recommended_actions": {
      "type": "array",
      "description": "List of recommended actions to improve score or resolve failures",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "doom_loop_check": {
      "type": "object",
      "description": "Optional: result of doom loop detection run during QA (C1 integration)",
      "properties": {
        "detected": { "type": "boolean" },
        "consecutive_count": { "type": "integer", "minimum": 0 },
        "action": {
          "type": "string",
          "enum": ["none", "warn", "escalate"]
        }
      },
      "required": ["detected", "consecutive_count", "action"]
    },
    "ajv_pre_check": {
      "type": "object",
      "description": "Optional: result of AJV schema validation run before LLM check (C6 integration)",
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "type": "object" }
        },
        "schemaId": { "type": "string" },
        "dataFile": { "type": "string" }
      },
      "required": ["valid", "errors"]
    }
  },
  "definitions": {
    "dimension": {
      "type": "object",
      "required": ["weight", "score", "weighted_score"],
      "additionalProperties": true,
      "properties": {
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Weight of this dimension in the final score (0.0–1.0)"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Raw score for this dimension (0.0–1.0)"
        },
        "weighted_score": {
          "type": "number",
          "minimum": 0,
          "description": "score * weight * 10 contribution to final_score"
        },
        "details": {
          "type": "string",
          "description": "Human-readable explanation of the score"
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "name", "result", "blocking"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique check identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable check name"
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIP", "WARN"],
          "description": "Result of the check"
        },
        "blocking": {
          "type": "boolean",
          "description": "Whether this check blocks the overall verdict on failure"
        },
        "message": {
          "type": "string",
          "description": "Details about the check result"
        },
        "location": {
          "type": "string",
          "description": "File or field where the issue was found"
        }
      }
    }
  }
}
