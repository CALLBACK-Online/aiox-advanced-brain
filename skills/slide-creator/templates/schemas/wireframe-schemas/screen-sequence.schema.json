{
  "$id": "aiox://slide-creator/wireframes/screen-sequence.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "A live or recorded demo needs a scripted sequence with expected proof moments.",
  "properties": {
    "demo_goal": {
      "description": "promise",
      "maxLength": 90,
      "type": "string"
    },
    "note_1": {
      "type": "string"
    },
    "note_2": {
      "type": "string"
    },
    "note_3": {
      "type": "string"
    },
    "proof_moment": {
      "description": "validation",
      "maxLength": 120,
      "type": "string"
    },
    "screen_1_label": {
      "type": "string"
    },
    "screen_2_label": {
      "type": "string"
    },
    "screen_3_label": {
      "type": "string"
    },
    "step_1": {
      "type": "string"
    },
    "step_2": {
      "type": "string"
    },
    "step_3": {
      "type": "string"
    }
  },
  "required": [
    "demo_goal",
    "proof_moment"
  ],
  "title": "screen-sequence",
  "type": "object",
  "x-aiox": {
    "absorbed_pattern_from": "presenton (Apache-2.0)",
    "function_ref": "demo_script",
    "slot_count": 11,
    "warnings": [
      "screen_1_label",
      "step_1",
      "note_1",
      "screen_2_label",
      "step_2",
      "note_2",
      "screen_3_label",
      "step_3",
      "note_3"
    ],
    "wireframe_ref": "templates/wireframes/screen-sequence.html"
  }
}
